# Copy this file to /opt/huatuo/.env and keep it mode 0600.
# Generate each secret with: openssl rand -hex 32

HUATUO_IMAGE=huatuo/huatuo-bamai-static
HUATUO_IMAGE_TAG=v2.2.0
ELASTIC_VERSION=8.15.5
GRAFANA_VERSION=12.0.3
INFINITY_DATASOURCE_VERSION=3.4.1

ELASTIC_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
API_ADMIN_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS

# Keep the UI private by default. Use an SSH tunnel to access port 3000.
GRAFANA_LISTEN_ADDRESS=127.0.0.1
